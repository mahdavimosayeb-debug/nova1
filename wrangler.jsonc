{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "nova1",
  "main": "worker.js",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    { "binding": "DB","database_id": "a9a837e1-6d91-4fef-b626-1649a2e53ac8","database_name": "nova1" }
  ],
  "kv_namespaces": [
    { "binding": "KV","id": "0f7dfa3fb80642f18aab9d393618541c" }
  ],
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
